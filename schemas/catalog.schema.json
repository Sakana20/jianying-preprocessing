{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/jypre/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "default_config_set", "config_sets"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "preprocess_config_catalog"},
    "default_config_set": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "config_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config_set_id", "display_name", "description", "tags", "path", "enabled"],
        "properties": {
          "config_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "display_name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.jsonc$"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
