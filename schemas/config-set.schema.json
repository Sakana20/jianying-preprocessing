{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/jypre/config-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "config_set_id", "display_name", "approval", "draft_compatibility", "asset_validation", "subtitle_style", "product_names", "benefit_points", "benefit_images", "risk_warning", "end_frame"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "preprocess_config_set"},
    "config_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "display_name": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": {"enum": ["draft", "approved"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "draft_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_version", "draft_version", "fps"],
      "properties": {
        "app_version": {"const": "5.9.0"},
        "draft_version": {"const": 360000},
        "fps": {"const": 30}
      }
    },
    "asset_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verify_sha256"],
      "properties": {
        "verify_sha256": {"type": "boolean"}
      }
    },
    "subtitle_style": {"$ref": "subtitle-style.schema.json"},
    "product_names": {"$ref": "product-names.schema.json"},
    "benefit_points": {"$ref": "benefit-points.schema.json"},
    "benefit_images": {"anyOf": [{"$ref": "benefit-images.schema.json"}, {"type": "null"}]},
    "risk_warning": {"anyOf": [{"$ref": "risk-warning.schema.json"}, {"type": "null"}]},
    "end_frame": {"anyOf": [{"$ref": "end-frame.schema.json"}, {"type": "null"}]}
  }
}
