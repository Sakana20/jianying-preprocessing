{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "items"],
  "properties": {"schema_version": {"const": 1}, "kind": {"const": "benefit_images"}, "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["benefit_image_id", "requires_benefit_ids", "match_mode", "asset", "timing", "cardinality", "placement", "animation_in"], "properties": {"benefit_image_id": {"type": "string"}, "requires_benefit_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "match_mode": {"const": "all_in_same_subtitle"}, "asset": {"$ref": "#/$defs/alpha_asset"}, "timing": {"const": "matched_subtitle_timerange"}, "cardinality": {"const": "one_per_business_video_segment"}, "placement": {"type": "object", "additionalProperties": false, "required": ["layer", "scale_x", "scale_y", "transform_x", "transform_y", "alpha", "rotation"], "properties": {"layer": {"const": "below_subtitles_above_business_video"}, "scale_x": {"type": "number"}, "scale_y": {"type": "number"}, "transform_x": {"type": "number"}, "transform_y": {"type": "number"}, "alpha": {"type": "number"}, "rotation": {"type": "number"}}}, "animation_in": {"type": "object", "additionalProperties": false, "required": ["name", "effect_id", "resource_id", "duration_us"], "properties": {"name": {"type": "string"}, "effect_id": {"type": "string"}, "resource_id": {"type": "string"}, "duration_us": {"const": 900000}}}}}}},
