{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "items", "line_break_rules"],
  "properties": {"schema_version": {"const": 1}, "kind": {"const": "benefit_points"}, "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["benefit_id", "literal", "priority", "style"], "properties": {"benefit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "literal": {"type": "string", "minLength": 1}, "priority": {"type": "integer"}, "style": {"$ref": "#/$defs/style"}}}}, "line_break_rules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["literal", "replacement"], "properties": {"literal": {"type": "string", "minLength": 1}, "replacement": {"type": "string", "minLength": 1}}}}},
  "$defs": {"style": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"fill": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "stroke": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "size": {"type": "number"}, "bold": {"type": "boolean"}}}}
}
